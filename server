    requested_id = str(data.get("client_id", "")).strip()

    if requested_id:
        client_id = requested_id
    else:
        client_id = "client-" + secrets.token_hex(4)

    if (
        not client_id
        or len(client_id) > 40
        or not all(c.isalnum() or c in "-_" for c in client_id)
    ):
        raise HTTPException(400, "Invalid client ID")

    if client_id in keys:
        raise HTTPException(409, "Client ID already exists")

    token = secrets.token_urlsafe(32)
    keys[client_id] = hashlib.sha256(token.encode()).hexdigest()
    save_json("keys.json", keys)

