SERVER = r'''
import asyncio
import base64
import hashlib
import hmac
import json
import logging
import re
import secrets
import subprocess
import threading
import time
import uuid

from pathlib import Path
from urllib.request import Request, urlopen
from urllib.error import HTTPError

import uvicorn
from fastapi import FastAPI, WebSocket, WebSocketDisconnect, Depends, HTTPException
from fastapi.responses import HTMLResponse, FileResponse
from fastapi.security import HTTPBasic, HTTPBasicCredentials

BASE = Path(__file__).resolve().parent
logging.basicConfig(level=logging.INFO)
log = logging.getLogger("remote-server")

app = FastAPI()
security = HTTPBasic()
HTML = __HTML__
CLIENT_TEMPLATE = __CLIENT_TEMPLATE__

clients = {}
pending = {}
ws_url = None
tunnel_process = None
ALLOWED = {"help", "ping", "get_version"}

def read_json(name, default):
    path = BASE / name
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text())
    except Exception:
        return default

def write_json(name, data):
    (BASE / name).write_text(json.dumps(data, indent=2))

def admin(credentials: HTTPBasicCredentials = Depends(security)):
    password = (BASE / "admin_password.txt").read_text().strip()
    if not hmac.compare_digest(credentials.password, password):
        raise HTTPException(401, "Incorrect password",
            headers={"WWW-Authenticate":"Basic"})
    return True

def make_client_file(client_id, token):
    settings = read_json("github_settings.json", {})
    config_url = (
        "https://raw.githubusercontent.com/"
        + settings["owner"] + "/"
        + settings["repo"] + "/"
        + settings["branch"] + "/"
        + settings["path"]
    )
    code = CLIENT_TEMPLATE.replace("__CLIENT_ID__", repr(client_id))
    code = code.replace("__CLIENT_TOKEN__", repr(token))
    code = code.replace("__CONFIG_URL__", repr(config_url))
    folder = BASE / "client_exports"
    folder.mkdir(exist_ok=True)
    path = folder / f"client_{client_id}.py"
    path.write_text(code)
    return path

def publish_github():
    global ws_url
    settings = read_json("github_settings.json", {})
    owner = settings.get("owner", "").strip()
    repo = settings.get("repo", "").strip()
    token = settings.get("token", "").strip()
    branch = settings.get("branch", "main")
    path = settings.get("path", "server.json")

    if not owner or not repo or not token or not ws_url:
        log.warning("GitHub settings are incomplete.")
        return

    api_url = f"https://api.github.com/repos/{owner}/{repo}/contents/{path}"
    headers = {
        "Authorization":"Bearer "+token,
        "Accept":"application/vnd.github+json",
        "X-GitHub-Api-Version":"2022-11-28",
        "User-Agent":"Remote-Control-Server"
    }

    content = json.dumps({
        "ws_url":ws_url,
        "updated_at":int(time.time())
    },indent=2)

    payload = {
        "message":"Update remote server URL",
        "content":base64.b64encode(content.encode()).decode(),
        "branch":branch
    }

    try:
        request=Request(api_url+"?ref="+branch,headers=headers)
        with urlopen(request,timeout=15) as response:
            existing=json.loads(response.read().decode())
            if existing.get("sha"):
                payload["sha"]=existing["sha"]
    except HTTPError as error:
        if error.code!=404:
            log.error("GitHub lookup failed: %s",error)
            return
    except Exception as error:
        log.error("GitHub lookup failed: %s",error)
        return

    request=Request(
        api_url,
        data=json.dumps(payload).encode(),
        headers={**headers,"Content-Type":"application/json"},
        method="PUT"
    )
    try:
        with urlopen(request,timeout=20) as response:
            response.read()
        log.info("GitHub address updated.")
    except Exception as error:
        log.error("GitHub publishing failed: %s",error)

def tunnel_reader(process):
    global ws_url
    while process.stdout:
        line=process.stdout.readline()
        if not line:
            break
        log.info("cloudflared: %s",line.strip())
        match=re.search(r"https://[a-zA-Z0-9-]+\.trycloudflare\.com",line)
        if match:
            ws_url=match.group(0).replace("https://","wss://")+"/ws"
            (BASE/"server_url.txt").write_text(ws_url)
            publish_github()

def start_tunnel():
    global tunnel_process
    try:
        tunnel_process=subprocess.Popen(
            ["cloudflared","tunnel","--url","http://127.0.0.1:8000"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1
        )
        threading.Thread(
            target=tunnel_reader,
            args=(tunnel_process,),
            daemon=True
        ).start()
    except FileNotFoundError:
        log.error("cloudflared is not installed.")

@app.on_event("startup")
async def startup():
    start_tunnel()

@app.on_event("shutdown")
async def shutdown():
    if tunnel_process:
        tunnel_process.terminate()

@app.get("/",response_class=HTMLResponse)
async def dashboard(auth=Depends(admin)):
    return HTML

@app.get("/api/status")
async def status(auth=Depends(admin)):
    keys=read_json("keys.json",{})
    return {
        "online":len(clients),
        "total":len(keys),
        "tunnel":bool(ws_url),
        "ws_url":ws_url,
        "clients":[
            {"id":cid,"online":cid in clients}
            for cid in keys
        ]
    }

@app.post("/api/addclient")
async def add_client(data:dict,auth=Depends(admin)):
    keys=read_json("keys.json",{})
    requested=str(data.get("client_id") or "").strip()
    client_id=requested or ("client-"+secrets.token_hex(4))

    if not re.fullmatch(r"[A-Za-z0-9_-]{1,40}",client_id):
        raise HTTPException(400,"Invalid client ID")
    if client_id in keys:
        raise HTTPException(409,"Client ID already exists")

    token=secrets.token_urlsafe(32)
    keys[client_id]=hashlib.sha256(token.encode()).hexdigest()
    write_json("keys.json",keys)
    make_client_file(client_id,token)

    return {
        "client_id":client_id,
        "download_url":"/api/client-download/"+client_id
    }

@app.get("/api/client-download/{client_id}")
async def download_client(client_id:str,auth=Depends(admin)):
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,40}",client_id):
        raise HTTPException(400,"Invalid client ID")
    path=BASE/"client_exports"/f"client_{client_id}.py"
    if not path.is_file():
        raise HTTPException(404,"Export not found")
    return FileResponse(path,filename=f"client_{client_id}.py")

@app.post("/api/removeclient")
async def remove_client(data:dict,auth=Depends(admin)):
    client_id=str(data.get("client_id",""))
    keys=read_json("keys.json",{})
    if client_id not in keys:
        raise HTTPException(404,"Client not found")
    del keys[client_id]
    write_json("keys.json",keys)
    active=clients.pop(client_id,None)
    if active:
        await active["ws"].close()
    path=BASE/"client_exports"/f"client_{client_id}.py"
    if path.exists():
        path.unlink()
    return {"ok":True}

@app.post("/api/command")
async def command(data:dict,auth=Depends(admin)):
    client_id=str(data.get("client_id",""))
    command_text=str(data.get("command","")).strip().lower()
    if command_text not in ALLOWED:
        raise HTTPException(400,"Allowed: help, ping, get_version")
    client=clients.get(client_id)
    if not client:
        raise HTTPException(404,"Client is offline")

    request_id=uuid.uuid4().hex
    future=asyncio.get_running_loop().create_future()
    pending[request_id]=future
    await client["queue"].put({
        "type":"command",
        "request_id":request_id,
        "command":command_text
    })
    try:
        return {"output":await asyncio.wait_for(future,timeout=15)}
    except asyncio.TimeoutError:
        raise HTTPException(504,"Client did not respond")
    finally:
        pending.pop(request_id,None)

@app.websocket("/ws")
async def websocket_endpoint(ws:WebSocket):
    await ws.accept()
    client_id=None
    sender_task=None
    try:
        raw=await asyncio.wait_for(ws.receive_text(),timeout=15)
        auth_data=json.loads(raw)
        if auth_data.get("type")!="auth":
            await ws.close(code=1008)
            return

        client_id=str(auth_data.get("client_id",""))
        token=str(auth_data.get("token",""))
        saved=read_json("keys.json",{}).get(client_id)
        supplied=hashlib.sha256(token.encode()).hexdigest()

        if not saved or not hmac.compare_digest(saved,supplied):
            await ws.send_json({"ok":False})
            await ws.close(code=1008)
            return

        queue=asyncio.Queue()
        clients[client_id]={"ws":ws,"queue":queue}
        await ws.send_json({"ok":True})
        log.info("Client connected: %s",client_id)

        async def sender():
            while True:
                await ws.send_json(await queue.get())

        sender_task=asyncio.create_task(sender())

        while True:
            message=json.loads(await ws.receive_text())
            if message.get("type")=="result":
                future=pending.get(message.get("request_id"))
                if future and not future.done():
                    future.set_result(str(message.get("output","")))

    except (WebSocketDisconnect,asyncio.TimeoutError):
        pass
    except Exception as error:
        log.warning("WebSocket error: %s",error)
    finally:
        if sender_task:
            sender_task.cancel()
        if client_id and clients.get(client_id,{}).get("ws") is ws:
            clients.pop(client_id,None)
            log.info("Client disconnected: %s",client_id)

if __name__=="__main__":
    uvicorn.run(app,host="127.0.0.1",port=8000)
'''

def main():
    print("Rebuild location:", BASE)

    # Verify the directory is correct before deleting anything.
    if not (BASE / "rebuild.py").is_file():
        raise RuntimeError("rebuild.py not found in its own directory")

    print("Removing old generated files...")

    old_files = [
        "server.py", "client.py", "keys.json",
        "requirements.txt", "server_url.txt",
        "cloudflared.log", "admin_password.txt",
        "github_settings.json"
    ]

    for name in old_files:
        path = BASE / name
        if path.is_file():
            path.unlink()

    for name in ["client_exports", "__pycache__"]:
        path = BASE / name
        if path.exists():
            shutil.rmtree(path)

    exports = BASE / "client_exports"
    exports.mkdir(parents=True)

    # Generate new credentials.
    client_id = "client1"
    client_token = secrets.token_urlsafe(32)
    admin_password = secrets.token_urlsafe(24)

    (BASE / "keys.json").write_text(json.dumps({
        client_id: hashlib.sha256(client_token.encode()).hexdigest()
    }, indent=2))

    (BASE / "admin_password.txt").write_text(admin_password)

    settings = {
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "YOUR_REPOSITORY",
        "branch": "main",
        "path": "server.json",
        "token": ""
    }
    (BASE / "github_settings.json").write_text(
        json.dumps(settings, indent=2)
    )

    config_url = (
        "https://raw.githubusercontent.com/"
        + settings["owner"] + "/"
        + settings["repo"] + "/"
        + settings["branch"] + "/"
        + settings["path"]
    )

    def generate_client(cid, token):
        code = CLIENT_TEMPLATE
        code = code.replace("__CLIENT_ID__", repr(cid))
        code = code.replace("__CLIENT_TOKEN__", repr(token))
        code = code.replace("__CONFIG_URL__", repr(config_url))
        return code

    client_code = generate_client(client_id, client_token)
    (BASE / "client.py").write_text(client_code)
    (exports / f"client_{client_id}.py").write_text(client_code)

    (BASE / "requirements.txt").write_text(
        "fastapi\nuvicorn\nwebsockets\n"
    )

    server_code = SERVER.replace("__HTML__", repr(HTML))
    server_code = server_code.replace(
        "__CLIENT_TEMPLATE__", repr(CLIENT_TEMPLATE)
    )
    (BASE / "server.py").write_text(server_code)

    (BASE / "cloudflared.log").write_text("")

    # Syntax-check all generated Python files.
    for name in ["server.py", "client.py",
                 f"client_exports/client_{client_id}.py"]:
        source = (BASE / name).read_text()
        compile(source, name, "exec")

    print()
    print("REBUILD SUCCESSFUL")
    print("Project folder:", BASE)
    print("Created server.py, client.py, keys.json")
    print("Created requirements.txt and GitHub settings")
    print("Created client_exports/client_client1.py")
    print()
    print("NEW ADMIN PASSWORD:")
    print(admin_password)
    print()
    print("New client ID:", client_id)
    print("Previous client credentials have been revoked.")

if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print("\nREBUILD FAILED:", error)
        sys.exit(1)
