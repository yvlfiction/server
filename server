CLIENT_TEMPLATE = r'''
import asyncio
import json
import platform
import urllib.request
import time
import websockets

CLIENT_ID = __CLIENT_ID__
CLIENT_TOKEN = __CLIENT_TOKEN__
CONFIG_URL = __CONFIG_URL__

async def get_server_url():
    def fetch():
        request = urllib.request.Request(
            CONFIG_URL,
            headers={"Cache-Control": "no-cache"}
        )
        with urllib.request.urlopen(request, timeout=15) as response:
            data = json.loads(response.read().decode())
            return data.get("ws_url")

    return await asyncio.to_thread(fetch)

async def main():
    print("Remote client started:", CLIENT_ID)

    while True:
        try:
            server_url = await get_server_url()

            if not server_url:
                raise RuntimeError("No server URL in GitHub config")

            print("Connecting to:", server_url)

            async with websockets.connect(
                server_url,
                ping_interval=20,
                ping_timeout=20
            ) as ws:

                await ws.send(json.dumps({
                    "type": "auth",
                    "client_id": CLIENT_ID,
                    "token": CLIENT_TOKEN
                }))

                response = json.loads(await ws.recv())

                if not response.get("ok"):
                    print("Authentication rejected")
                    return

                print("Connected successfully")

                async for raw in ws:
                    message = json.loads(raw)

                    if message.get("type") != "command":
                        continue

                    command = message.get("command", "").strip().lower()
                    output = ""

                    if command == "help":
                        output = "Available commands: help, ping, get_version"

                    elif command == "ping":
                        output = "Pong"

                    elif command == "get_version":
                        output = (
                            "Python: " + platform.python_version()
                            + "\nPlatform: " + platform.platform()
                        )

                    else:
                        output = "Command not allowed"

                    await ws.send(json.dumps({
                        "type": "result",
                        "request_id": message.get("request_id"),
                        "output": output
                    }))

        except Exception as error:
            print("Connection error:", error)

        print("Retrying in 5 seconds...")
        await asyncio.sleep(5)

if __name__ == "__main__":
    asyncio.run(main())
'''

