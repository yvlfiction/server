def github_diag():
    print(f"\n  [github] Testing token...")
    try:
        req = urllib.request.Request(
            f"https://api.github.com/repos/"
            f"{GITHUB_OWNER}/{GITHUB_REPO}",
            headers={"Authorization": f"token {GITHUB_TOKEN}"}
        )
        with urllib.request.urlopen(req) as r:
            d = json.loads(r.read())
            print(f"  [github] OK: {d['full_name']}")
    except urllib.error.HTTPError as e:
        print(f"  [github] FAIL {e.code}: {e.read().decode()[:200]}")
    except Exception as e:
        print(f"  [github] ERR: {e}")

def github_push_url(url):
    try:
        url_api = (
            f"https://api.github.com/repos/"
            f"{GITHUB_OWNER}/{GITHUB_REPO}/contents/{GITHUB_FILE}"
        )
        hdrs = {
            "Authorization": f"token {GITHUB_TOKEN}",
            "Content-Type": "application/json"
        }
        try:
            req = urllib.request.Request(url_api, headers=hdrs)
            with urllib.request.urlopen(req) as r:
                sha = json.loads(r.read())["sha"]
            payload = {
                "message": f"URL: {url}",
                "content": url.encode().hex(),
                "sha": sha
            }
        except urllib.error.HTTPError as e:
            if e.code == 404:
                payload = {
                    "message": f"Create: {url}",
                    "content": url.encode().hex()
                }
            else:
                raise
        req2 = urllib.request.Request(
            url_api, data=json.dumps(payload).encode(),
            headers=hdrs, method="PUT"
        )
        with urllib.request.urlopen(req2) as r:
            pass
        print(f"  [github] Pushed: {url}")
    except urllib.error.HTTPError as e:
        print(f"  [github] Push FAIL {e.code}: {e.read().decode()[:200]}")
    except Exception as e:
        print(f"  [github] Push ERR: {e}")

def start_cloudflared():
    cmd = ["cloudflared", "tunnel", "--url",
           f"http://localhost:{PORT}"]
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )
    url = None
    for _ in range(60):
        line = proc.stdout.readline()
        if not line:
            break
        sys.stdout.write(f"  [cf] {line.strip()}\n")
        if "trycloudflare.com" in line and "https://" in line:
            after = line.split("https://")[1]
            url = after.split("|")[0].split()[0].rstrip(".,)")
            break
    return proc, url

