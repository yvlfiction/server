# ─── STATE ────────────────────────────────────────────────────────────────────
clients: dict[str, dict] = {}
dashboard_ws: set[web.WebSocketResponse] = set()

def save_clients():
    data = {cid: {"token": c["token"], "info": c["info"]} for cid, c in clients.items()}
    CLIENTS_FILE.write_text(json.dumps(data, indent=2))

def load_clients():
    if CLIENTS_FILE.exists():
        data = json.loads(CLIENTS_FILE.read_text())
        for cid, info in data.items():
            clients[cid] = {"token": info["token"], "info": info["info"], "ws": None, "since": 0}

# ─── HANDLERS ─────────────────────────────────────────────────────────────────

async def index(request):
    return web.Response(text=DASHBOARD_HTML, content_type="text/html")

async def dashboard_ws_handler(request):
    ws = web.WebSocketResponse()
    await ws.prepare(request)
    dashboard_ws.add(ws)
    # send current state
    await ws.send_json({"type": "clients", "clients": [
        {"id": cid, "info": c["info"], "since": c["since"]} for cid, c in clients.items() if c["ws"]
    ]})
    try:
        async for msg in ws:
            if msg.type == WSMsgType.TEXT:
                d = json.loads(msg.data)
                if d["type"] == "cmd":
                    cid, cmd = d["id"], d["cmd"]
                    if cid in clients and clients[cid]["ws"]:
                        await clients[cid]["ws"].send_json({"type": "cmd", "cmd": cmd})
                elif d["type"] == "kill":
                    cid = d["id"]
                    if cid in clients and clients[cid]["ws"]:
                        await clients[cid]["ws"].close()
                        del clients[cid]
                    broadcast()
            elif msg.type == WSMsgType.CLOSE:
                break
    finally:
        dashboard_ws.discard(ws)
    return ws

def broadcast():
    payload = json.dumps({"type": "clients", "clients": [
        {"id": cid, "info": c["info"], "since": c["since"]} for cid, c in clients.items() if c["ws"]
    ]})
    for ws in list(dashboard_ws):
        asyncio.ensure_future(ws.send_str(payload))

async def client_ws_handler(request):
    ws = web.WebSocketResponse()
    await ws.prepare(request)
    cid = None
    try:
        async for msg in ws:
            if msg.type == WSMsgType.TEXT:
                d = json.loads(msg.data)
                if d["type"] == "register":
                    cid = d["id"]
                    if cid in clients and clients[cid]["token"] == d["token"]:
                        clients[cid]["ws"] = ws
                        clients[cid]["since"] = time.time()
                        clients[cid]["info"] = d["info"]
                        broadcast()
                        save_clients()
                    else:
                        await ws.close(code=4001, message=b"bad auth")
                        return ws
                elif d["type"] == "output":
                    for dw in list(dashboard_ws):
                        try:
                            await dw.send_json(d)
                        except Exception:
                            pass
                elif d["type"] == "pong":
                    pass
            elif msg.type == WSMsgType.CLOSE:
                break
    finally:
        if cid and cid in clients:
            clients[cid]["ws"] = None
            broadcast()
    return ws

async def client_download(request):
    """Serves a one-shot client script (no fixed ID — generates one)."""
    cid = secrets.token_hex(6)
    token = secrets.token_hex(16)
    clients[cid] = {"token": token, "info": {}, "ws": None, "since": 0}
    save_clients()
    server_host = request.host
    code = CLIENT_TEMPLATE.replace("__CLIENT_ID__", cid).replace("__CLIENT_TOKEN__", token).replace("__SERVER__", server_host)
    return web.Response(text=code, content_type="text/x-python")

async def api_rebuild(request):
    """Returns the client download command + a standalone script."""
    cid = secrets.token_hex(6)
    token = secrets.token_hex(16)
    clients[cid] = {"token": token, "info": {}, "ws": None, "since": 0}
    save_clients()
    code = CLIENT_TEMPLATE.replace("__CLIENT_ID__", cid).replace("__CLIENT_TOKEN__", token).replace("__SERVER__", f"{HOST}:{PORT}")
    return web.Response(text=f"# Client ID: {cid}\n# Save as client.py and run: python3 client.py\n\n{code}", content_type="text/plain")

async def api_clients(request):
    return web.json_response([
        {"id": cid, "info": c["info"], "online": bool(c["ws"]), "since": c["since"]}
        for cid, c in clients.items()
    ])

# ─── MAIN ─────────────────────────────────────────────────────────────────────

async def on_startup(app):
    load_clients()
    print(f"\n  ⬡ Command Server running on http://{HOST}:{PORT}")
    print(f"  Dashboard: http://localhost:{PORT}")
    print(f"  Client:    curl -s http://<your-ip>:{PORT}/client | python3\n")

async def on_shutdown(app):
    for ws in dashboard_ws:
        await ws.close()
    for c in clients.values():
        if c["ws"]:
            await c["ws"].close()

def main():
    app = web.Application()
    app.on_startup.append(on_startup)
    app.on_shutdown.append(on_shutdown)
    app.router.add_get("/", index)
    app.router.add_get("/ws/dashboard", dashboard_ws_handler)
    app.router.add_get("/ws/client", client_ws_handler)
    app.router.add_get("/client", client_download)
    app.router.add_get("/api/rebuild", api_rebuild)
    app.router.add_get("/api/clients", api_clients)
    web.run_app(app, host=HOST, port=PORT)

if __name__ == "__main__":
    main()   
