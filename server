# ─── GITHUB HELPERS ───────────────────────────────────────────────────────────
def github_push_url(url):
    """Push URL to GitHub site file. Tries update first, then create."""
    api_base = f"https://api.github.com/repos/{GITHUB_OWNER}/{GITHUB_REPO}/contents/{GITHUB_FILE}"
    headers = {"Authorization": f"Bearer {GITHUB_TOKEN}", "Content-Type": "application/json"}
    try:
        # Try to get existing file (to get sha)
        try:
            req = urllib.request.Request(api_base, headers=headers)
            with urllib.request.urlopen(req) as r:
                sha = json.loads(r.read())["sha"]
            # Update existing file
            payload = json.dumps({"message": f"URL: {url}", "content": url.encode().hex(), "sha": sha}).encode()
            req2 = urllib.request.Request(api_base, data=payload, headers=headers, method="PUT")
            with urllib.request.urlopen(req2) as r:
                pass
            print(f"  ✓ URL updated on GitHub")
            return True
        except urllib.error.HTTPError as e:
            if e.code == 404:
                # File doesn't exist, create it
                payload = json.dumps({"message": f"Create: {url}", "content": url.encode().hex()}).encode()
                req3 = urllib.request.Request(api_base, data=payload, headers=headers, method="PUT")
                with urllib.request.urlopen(req3) as r:
                    pass
                print(f"  ✓ URL file created on GitHub")
                return True
            elif e.code == 401:
                body = e.read().decode()[:200]
                print(f"  ✗ GitHub 401: Token has no access to {GITHUB_OWNER}/{GITHUB_REPO}")
                print(f"    Fix: github.com/settings/tokens → grant Contents: Read+Write to this repo")
                print(f"    Detail: {body}")
                return False
            else:
                body = e.read().decode()[:200]
                print(f"  ✗ GitHub {e.code}: {body}")
                return False
    except Exception as e:
        print(f"  ✗ GitHub push failed: {e}")
        return False

