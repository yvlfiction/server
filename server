cd /home/server/command-server

cp -f server rebuild.py

python3 - <<'PY'
from pathlib import Path

p = Path("rebuild.py")
code = p.read_text()

code = code.replace("import sys\n", "import sys\nimport getpass\n", 1)
code = code.replace('"owner": "YOUR_GITHUB_USERNAME"', '"owner": "yvlfiction"')
code = code.replace('"repo": "YOUR_REPOSITORY"', '"repo": "server"')
code = code.replace(
    '"token": ""',
    '"token": getpass.getpass("GitHub token (Contents: Read and write): ").strip()',
    1
)

if "YOUR_GITHUB_USERNAME" in code or "YOUR_REPOSITORY" in code:
    raise SystemExit("Repository settings were not fixed.")

p.write_text(code)
print("Rebuild script prepared.")
PY
