import asyncio
import base64
import hashlib
import hmac
import json
import re
import secrets
import subprocess
import threading
import urllib.request
import urllib.error

from pathlib import Path
from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi import Depends, HTTPException
from fastapi.security import HTTPBasic, HTTPBasicCredentials
from fastapi.responses import HTMLResponse, FileResponse
from pydantic import BaseModel
import uvicorn

BASE = Path(__file__).resolve().parent
KEYS_FILE = BASE / "keys.json"
URL_FILE = BASE / "server_url.txt"
LOG_FILE = BASE / "cloudflared.log"
PASSWORD_FILE = BASE / "admin_password.txt"
GITHUB_FILE = BASE / "github_settings.json"
EXPORT_DIR = BASE / "client_exports"
EXPORT_DIR.mkdir(exist_ok=True)

# Preserve the admin password between server restarts.
if not PASSWORD_FILE.exists():
    PASSWORD_FILE.write_text(secrets.token_urlsafe(20))
    try:
        PASSWORD_FILE.chmod(0o600)
    except OSError:
        pass

ADMIN_USER = "admin"
ADMIN_PASSWORD = PASSWORD_FILE.read_text().strip()
security = HTTPBasic()

app = FastAPI()
clients = {}
client_outputs = {}
output_sequence = {}
tunnel_url = None
tunnel_process = None

ALLOWED_COMMANDS = {"help", "ping", "get_version"}

def load_keys():
    try:
        return json.loads(KEYS_FILE.read_text())
    except Exception:
        return {}

def save_keys(keys):
    temp = KEYS_FILE.with_suffix(".tmp")
    temp.write_text(json.dumps(keys, indent=4))
    temp.replace(KEYS_FILE)

def hash_token(token):
    return hashlib.sha256(token.encode()).hexdigest()

def require_admin(credentials: HTTPBasicCredentials = Depends(security)):
    good_user = hmac.compare_digest(credentials.username, ADMIN_USER)
    good_pass = hmac.compare_digest(credentials.password, ADMIN_PASSWORD)
    if not (good_user and good_pass):
        raise HTTPException(
            status_code=401,
            detail="Invalid admin login",
            headers={"WWW-Authenticate": "Basic"}
        )
    return credentials.username

class ClientRequest(BaseModel):
    client_id: str

class CommandRequest(BaseModel):
    client_id: str
    command: str

def github_settings():
    try:
        return json.loads(GITHUB_FILE.read_text())
    except Exception:
        return {}

def publish_github_config(ws_url):
    cfg = github_settings()
    owner = cfg.get("owner", "")
    repo = cfg.get("repo", "")
    branch = cfg.get("branch", "main")
    path = cfg.get("path", "server.json")
    token = cfg.get("token", "")

    if (not owner or not repo or not token or
        owner.startswith("YOUR_") or repo.startswith("YOUR_") or
        token.startswith("PASTE_")):
        print("[GitHub] Configure github_settings.json first.")
        return

    api_url = f"https://api.github.com/repos/{owner}/{repo}/contents/{path}"
    headers = {
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "Fiction-Command-Center"
    }

    payload = {
        "message": "Update Cloudflare server address",
        "content": base64.b64encode(
            json.dumps({"ws_url": ws_url}, indent=2).encode()
        ).decode(),
        "branch": branch
    }

    # GitHub requires the existing file SHA when updating a file.
    try:
        req = urllib.request.Request(api_url, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as response:
            existing = json.loads(response.read().decode())
        payload["sha"] = existing["sha"]
    except urllib.error.HTTPError as error:
        if error.code != 404:
            print("[GitHub] Could not read config:", error)
            return

    req = urllib.request.Request(
        api_url,
        data=json.dumps(payload).encode(),
        headers={**headers, "Content-Type": "application/json"},
        method="PUT"
    )

    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            response.read()
        print("[GitHub] Server URL updated successfully.")
    except Exception as error:
        print("[GitHub] Update failed:", error)

def make_client_file(client_id, token):
    cfg = github_settings()
    owner = cfg.get("owner", "YOUR_GITHUB_USERNAME")
    repo = cfg.get("repo", "YOUR_REPOSITORY")
    branch = cfg.get("branch", "main")
    path = cfg.get("path", "server.json")

    config_url = (
        f"https://raw.githubusercontent.com/"
        f"{owner}/{repo}/{branch}/{path}"
    )

    template = r'''
import asyncio
import json
import platform
import urllib.request
import websockets

CLIENT_ID = __CLIENT_ID__
CLIENT_TOKEN = __CLIENT_TOKEN__
CONFIG_URL = __CONFIG_URL__

def get_server_url():
    if "YOUR_GITHUB_USERNAME" in CONFIG_URL or "YOUR_REPOSITORY" in CONFIG_URL:
        raise RuntimeError("GitHub config is not configured yet.")

    request = urllib.request.Request(
        CONFIG_URL,
        headers={"Cache-Control": "no-cache"}
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        data = json.loads(response.read().decode())

    url = data.get("ws_url", "").strip()
    if not url.startswith(("wss://", "ws://")):
        raise RuntimeError("Invalid server URL in GitHub config.")
    return url

async def main():
    while True:
        try:
            url = await asyncio.to_thread(get_server_url)
            print("Connecting to:", url)

            async with websockets.connect(
                url, ping_interval=20, ping_timeout=20
            ) as ws:
                await ws.send(json.dumps({
                    "client_id": CLIENT_ID,
                    "token": CLIENT_TOKEN
                }))

                auth = json.loads(await ws.recv())
                if not auth.get("ok"):
                    print("Authentication failed. Access may be revoked.")
                    return

                print("Connected and authenticated.")

                async for raw in ws:
                    message = json.loads(raw)
                    action = message.get("action")
                    request_id = message.get("request_id")

                    if action == "ping":
                        output = "pong"
                    elif action == "get_version":
                        output = "Python " + platform.python_version()
                    elif action == "help":
                        output = "Allowed: help, ping, get_version"
                    else:
                        output = "Command not allowed"

                    await ws.send(json.dumps({
                        "type": "result",
                        "request_id": request_id,
                        "output": output
                    }))

        except Exception as error:
            print("Connection error:", error)
            print("Checking GitHub and retrying in 5 seconds...")
            await asyncio.sleep(5)

if __name__ == "__main__":
    asyncio.run(main())
'''

    code = template.replace("__CLIENT_ID__", repr(client_id))
    code = code.replace("__CLIENT_TOKEN__", repr(token))
    code = code.replace("__CONFIG_URL__", repr(config_url))

    target = EXPORT_DIR / f"client_{client_id}.py"
    target.write_text(code)
    return target

@app.get("/", response_class=HTMLResponse)
async def dashboard(user=Depends(require_admin)):
    return HTMLResponse(HTML)

@app.get("/api/status")
async def status(user=Depends(require_admin)):
