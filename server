async def main():
    config = uvicorn.Config(
        app,
        host="127.0.0.1",
        port=8000,
        log_level="warning"
    )

    server = uvicorn.Server(config)
    task = asyncio.create_task(server.serve())

    while not server.started:
        if task.done():
            await task
            return
        await asyncio.sleep(0.1)

    print("\nPython server started.")
    print("Dashboard username:", ADMIN_USER)
    print("Dashboard password is saved in admin_password.txt")
