import asyncio
import json
import websockets

TOKEN = "your_token_here"  # the original token you hashed to get that key

async def main():
    async with websockets.connect("ws://127.0.0.1:8000/ws") as ws:
        # Authenticate
        await ws.send(json.dumps({"client_id": "client1", "token": TOKEN}))
        resp = json.loads(await ws.receive())
        if not resp.get("ok"):
            print("Auth failed")
            return
        print("Connected.")

        # Listen for commands
        while True:
            msg = json.loads(await ws.receive())
            if msg.get("command") == "ping":
                await ws.send(json.dumps({"result": "pong"}))
            elif msg.get("command") == "get_version":
                await ws.send(json.dumps({"result": "1.0"}))

asyncio.run(main())   
