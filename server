    }

@app.post("/api/command")
async def command(data: CommandRequest, user=Depends(require_admin)):
    action = data.command.strip().lower()

    if action not in ALLOWED_COMMANDS:
        raise HTTPException(
            status_code=400,
            detail="Allowed commands: help, ping, get_version"
        )

    ws = clients.get(data.client_id)
    if not ws:
        raise HTTPException(status_code=404, detail="Client is offline")

    await ws.send_json({
        "action": action,
        "request_id": secrets.token_hex(8)
    })
    return {"ok": True}

@app.post("/api/addclient")
async def add_client(data: ClientRequest, user=Depends(require_admin)):
    cid = data.client_id.strip()

    if not re.fullmatch(r"[A-Za-z0-9_-]{1,40}", cid):
        raise HTTPException(
            status_code=400,
            detail="Use 1-40 letters, numbers, _ or -"
        )

    keys = load_keys()
    if cid in keys:
        raise HTTPException(status_code=409, detail="Client already exists")

    token = secrets.token_urlsafe(32)
    keys[cid] = hash_token(token)
    save_keys(keys)
    make_client_file(cid, token)

    return {
        "client_id": cid,
        "download_url": f"/api/client-download/{cid}"
    }

@app.get("/api/client-download/{client_id}")
async def download_client(client_id: str, user=Depends(require_admin)):
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,40}", client_id):
        raise HTTPException(status_code=400, detail="Invalid client ID")

    target = EXPORT_DIR / f"client_{client_id}.py"
    if not target.exists():
        raise HTTPException(status_code=404, detail="Client file not found")

    return FileResponse(
        target,
        filename=target.name,
        media_type="text/x-python"
    )

@app.post("/api/removeclient")
async def remove_client(data: ClientRequest, user=Depends(require_admin)):
    cid = data.client_id.strip()
    keys = load_keys()

    if cid not in keys:
        raise HTTPException(status_code=404, detail="Client not found")

    del keys[cid]
    save_keys(keys)

    ws = clients.pop(cid, None)
    if ws:
        try:
            await ws.close(code=1008, reason="Access revoked")
        except Exception:
            pass

    client_outputs.pop(cid, None)
    output_sequence.pop(cid, None)

    export = EXPORT_DIR / f"client_{cid}.py"
    if export.exists():
        export.unlink()

    return {"ok": True}

@app.websocket("/ws")
async def websocket_endpoint(ws: WebSocket):
    await ws.accept()
    client_id = None

    try:
        auth = json.loads(await ws.receive_text())
        client_id = auth.get("client_id")
        token = auth.get("token", "")

        if not isinstance(client_id, str):
            await ws.close(code=1008)
            return

        if load_keys().get(client_id) != hash_token(token):
            await ws.send_json({"ok": False})
            await ws.close(code=1008)
            return

        old = clients.get(client_id)
        if old and old is not ws:
            try:
                await old.close(code=1008, reason="New connection")
            except Exception:
                pass

        clients[client_id] = ws
        await ws.send_json({"ok": True})
        print(f"\n[+] {client_id} connected")

        while True:
            message = json.loads(await ws.receive_text())

            # New client response format.
            if message.get("type") == "result":
                output = str(message.get("output", ""))[:2000]

            # Compatibility with the original client.py.
            elif "response" in message:
                output = str(message["response"])[:2000]
            elif "version" in message:
                output = "Python " + str(message["version"])[:2000]
            else:
                continue

            client_outputs[client_id] = output
            output_sequence[client_id] = (
                output_sequence.get(client_id, 0) + 1
            )
            print(f"[{client_id}] {output}")

    except (WebSocketDisconnect, Exception):
        pass

    finally:
        if client_id and clients.get(client_id) is ws:
            clients.pop(client_id, None)
            print(f"\n[-] {client_id} disconnected")

def start_tunnel():
    global tunnel_process, tunnel_url

    try:
        tunnel_process = subprocess.Popen(
            [
                "cloudflared", "tunnel",
                "--no-autoupdate",
                "--url", "http://127.0.0.1:8000"
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1
        )

        def read_output():
            global tunnel_url

            with open(LOG_FILE, "a") as log:
                for line in tunnel_process.stdout:
                    log.write(line)
                    log.flush()

                    match = re.search(
                        r"https://[a-zA-Z0-9-]+\.trycloudflare\.com",
                        line
                    )

                    if match and not tunnel_url:
                        tunnel_url = match.group(0)
                        ws_url = tunnel_url.replace(
                            "https://", "wss://"
                        ) + "/ws"

                        URL_FILE.write_text(ws_url)

                        print("\n" + "=" * 45)
                        print("PUBLIC DASHBOARD:", tunnel_url)
                        print("CLIENT WEBSOCKET:", ws_url)
                        print("=" * 45)

                        publish_github_config(ws_url)

        threading.Thread(target=read_output, daemon=True).start()

    except FileNotFoundError:
        print("ERROR: cloudflared is not installed.")

