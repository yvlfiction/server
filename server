  termBody.innerHTML += `<div class="prompt">$ ${cmd}</div><div class="output" id="out-${Date.now()}">⏳ running…</div>`;
  termBody.scrollTop = termBody.scrollHeight;
  ws.send(JSON.stringify({type:'cmd', id: currentClient, cmd}));
