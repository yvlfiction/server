CLIENT_TEMPLATE = r'''
import asyncio
import json
import platform
import urllib.request
import websockets

CLIENT_ID = __CLIENT_ID__
CLIENT_TOKEN = __CLIENT_TOKEN__
CONFIG_URL = __CONFIG_URL__

async def get_server_url():
    def fetch():
        request = urllib.request.Request(
            CONFIG_URL,
            headers={"Cache-Control": "no-cache"}
        )
        with urllib.request.urlopen(request, timeout=15) as response:
            return json.loads(response.read().decode()).get("ws_url")

    return await asyncio.to_thread(fetch)

async def main():
    print("Client:", CLIENT_ID)

    while True:
        try:
            url = await get_server_url()
            if not url:
                raise RuntimeError("GitHub config has no ws_url")

            async with websockets.connect(
                url, ping_interval=20, ping_timeout=20
            ) as ws:
                await ws.send(json.dumps({
                    "type": "auth",
                    "client_id": CLIENT_ID,
                    "token": CLIENT_TOKEN
                }))

                auth = json.loads(await ws.recv())
                if not auth.get("ok"):
                    print("Authentication failed")
                    return

                print("Connected")

                async for raw in ws:
                    message = json.loads(raw)
                    if message.get("type") != "command":
                        continue

                    command = message.get("command", "").strip().lower()

                    if command == "help":
                        output = "Available: help, ping, get_version"
                    elif command == "ping":
                        output = "Pong"
                    elif command == "get_version":
                        output = (
                            "Python: " + platform.python_version()
                            + "\nPlatform: " + platform.platform()
                        )
                    else:
                        output = "Command not allowed"

                    await ws.send(json.dumps({
                        "type": "result",
                        "request_id": message.get("request_id"),
                        "output": output
                    }))

        except Exception as error:
            print("Connection error:", error)

        await asyncio.sleep(5)

if __name__ == "__main__":
    asyncio.run(main())
'''

