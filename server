@app.post("/api/command")
async def command(data: dict, auth=Depends(authenticate)):
    client_id = str(data.get("client_id", ""))
    command_text = str(data.get("command", "")).strip().lower()

    if command_text not in ALLOWED_COMMANDS:
        raise HTTPException(
            400,
            "Only help, ping, and get_version are allowed."
        )

    client = clients.get(client_id)

    if not client:
        raise HTTPException(404, "Client is offline")

    request_id = uuid.uuid4().hex
    future = asyncio.get_running_loop().create_future()
    pending[request_id] = future

    await client["queue"].put({
        "type": "command",
        "request_id": request_id,
        "command": command_text
    })

    try:
        output = await asyncio.wait_for(future, timeout=15)
        return {"output": output}
    except asyncio.TimeoutError:
        raise HTTPException(504, "Client did not respond")
    finally:
        pending.pop(request_id, None)

@app.websocket("/ws")
async def websocket_endpoint(ws: WebSocket):
    await ws.accept()

    client_id = None
    sender_task = None

    try:
        raw = await asyncio.wait_for(ws.receive_text(), timeout=15)
        auth = json.loads(raw)

        if auth.get("type") != "auth":
            await ws.close(code=1008)
            return

        client_id = str(auth.get("client_id", ""))
        token = str(auth.get("token", ""))

        saved_hash = load_keys().get(client_id)
        supplied_hash = hashlib.sha256(token.encode()).hexdigest()

        import hmac
        if not saved_hash or not hmac.compare_digest(saved_hash, supplied_hash):
            await ws.send_json({"ok":False})
            await ws.close(code=1008)
            return

        queue = asyncio.Queue()
        clients[client_id] = {
            "ws": ws,
            "queue": queue
        }

        await ws.send_json({"ok":True})
        log.info("Client connected: %s", client_id)

        async def sender():
            while True:
                message = await queue.get()
                await ws.send_json(message)

        sender_task = asyncio.create_task(sender())

        while True:
            raw = await ws.receive_text()
            message = json.loads(raw)

            if message.get("type") == "result":
                request_id = message.get("request_id")
                future = pending.get(request_id)

                if future and not future.done():
                    future.set_result(str(message.get("output", "")))

    except (WebSocketDisconnect, asyncio.TimeoutError):
        pass
    except Exception as error:
        log.warning("WebSocket error: %s", error)
    finally:
        if sender_task:
            sender_task.cancel()

        if client_id and clients.get(client_id, {}).get("ws") is ws:
            clients.pop(client_id, None)
            log.info("Client disconnected: %s", client_id)

if __name__ == "__main__":
    uvicorn.run(app, host="127.0.0.1", port=8000)
